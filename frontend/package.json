  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-bundle-size.mjs && node scripts/upload-sourcemaps.mjs && node scripts/delete-sourcemaps.mjs",
