{
  "name": "equip frontend: RUM error spike",
  "type": "rum alert",
  "query": "rum(\"@type:error service:equip-frontend env:production\").rollup(\"count\").last(\"10m\") >= 10",
  "message": "Frontend logged 10+ RUM errors in 10 minutes. Investigate at https://app.us5.datadoghq.com/rum/explorer\n\nNotify: @arvavitcorp@gmail.com",
  "tags": [
    "env:production",
    "project:equip",
    "managed_by:claude"
  ],
  "priority": 2,
  "options": {
    "thresholds": {
      "warning": 5.0,
      "critical": 10.0
    },
    "evaluation_delay": 60,
    "notify_audit": false,
    "include_tags": true,
    "renotify_interval": 0,
    "notify_no_data": false,
    "new_host_delay": 300,
    "groupby_simple_monitor": false,
    "silenced": {}
  }
}
