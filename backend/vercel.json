{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/translation-worker",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/v1/internal/daily-challenge-worker",
      "schedule": "0 9 * * *"
    }
  ]
}
