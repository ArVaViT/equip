{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/translation-worker",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/v1/internal/daily-challenge-worker",
      "schedule": "0 9 * * *"
    }
  ]
}
