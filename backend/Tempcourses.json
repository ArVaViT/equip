[{"id":"a254afa9-5064-4866-a4c3-be7c1dfca4c5","course_id":"7a57298d-814e-4c08-ab88-1099a54bf507","title":"The Old Testament (39 books)","description":"Common English order in five sections (Law, history, wisdom/poetry, major prophets, minor prophets), without debating dates or authorship.","order_index":0,"due_date":null,"chapters":[{"id":"29d4f6ef-e7e5-4556-9180-89d9027f93fb","module_id":"a254afa9-5064-4866-a4c3-be7c1dfca4c5","title":"Thirty-nine and twenty-seven","order_index":0,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"25d7d0bf-0873-4fa3-835e-57d8cbdfb0f4","module_id":"a254afa9-5064-4866-a4c3-be7c1dfca4c5","title":"The Old Testament in five “shelves”","order_index":1,"chapter_type":"reading","requires_completion":false,"is_locked":false}]},{"id":"f8b5c5f9-143c-447b-9ecb-721f2cce4e43","course_id":"7a57298d-814e-4c08-ab88-1099a54bf507","title":"The New Testament (27 books)","description":"Gospels, Acts, letters, Revelation—the usual second half in Protestant/English Bibles.","order_index":1,"due_date":null,"chapters":[{"id":"88705e99-5a60-43be-9562-8016409de785","module_id":"f8b5c5f9-143c-447b-9ecb-721f2cce4e43","title":"The usual New Testament order","order_index":0,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"53368f0e-d46c-4bb8-815f-860a5f5fb2a0","module_id":"f8b5c5f9-143c-447b-9ecb-721f2cce4e43","title":"How references work","order_index":1,"chapter_type":"reading","requires_completion":false,"is_locked":false}]},{"id":"4316e62b-2c17-43eb-9cc8-41451a476445","course_id":"7a57298d-814e-4c08-ab88-1099a54bf507","title":"Check your map","description":"Short factual quiz: counts and sections, not Bible interpretation.","order_index":2,"due_date":null,"chapters":[{"id":"88c16bb0-9523-461d-b1e6-d137a4f36970","module_id":"4316e62b-2c17-43eb-9cc8-41451a476445","title":"Quick check (5 questions)","order_index":0,"chapter_type":"quiz","requires_completion":false,"is_locked":false}]}]},{"title":"Книга Деяний Апостолов: от Иерусалима до края земли","description":"Академический курс по книге Деяний святых Апостолов в тринадцати уроках. Курс последовательно проходит все двадцать восемь глав, от рождения Церкви в день Пятидесятницы до прибытия Евангелия в Рим, и соединяет богословский разбор с историческим, литературным и прикладным анализом. Материал построен так, чтобы преподаватель мог взять любой урок и провести занятие без дополнительной подготовки, а студент после урока повторил тот же материал и успешно прошёл аттестацию. Четыре модуля, три мини-квиза, итоговый экзамен из сорока вопросов и обязательное эссе по прочитанной книге Деяний.","image_url":"https://rrisqutxlkamwfhcashl.supabase.co/storage/v1/object/public/course-assets/acts-course/banner-v2.png","id":"1f3c4803-d229-464b-ad8e-848a0355e71f","status":"published","access_mode":"public","created_by":"109bc291-018d-4e43-8a7c-385a35bd6800","created_at":"2026-04-21T03:51:49.324549Z","updated_at":"2026-04-22T13:47:38.758158Z","deleted_at":null,"enrollment_start":null,"enrollment_end":null,"modules":[{"id":"365e5da2-5caa-4b8b-9ac8-91f1498aa6df","course_id":"1f3c4803-d229-464b-ad8e-848a0355e71f","title":"Модуль 1. Введение и рождение Церкви (Деяния 1–5)","description":"Вводный модуль знакомит с автором, целью и планом книги Деяний, рассказывает о сошествии Святого Духа в день Пятидесятницы и описывает жизнь первой Иерусалимской общины и её первые испытания.","order_index":0,"due_date":null,"chapters":[{"id":"692d3657-b33c-4d07-84fe-87bd8a053460","module_id":"365e5da2-5caa-4b8b-9ac8-91f1498aa6df","title":"Урок 1. Введение в книгу Деяний: автор, цель, структура","order_index":0,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"e1a79617-1301-4116-b127-b3a813ef9119","module_id":"365e5da2-5caa-4b8b-9ac8-91f1498aa6df","title":"Урок 2. Пятидесятница: рождение Церкви (Деяния 1:12–2:47)","order_index":1,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"dc06b48c-82d5-4009-a4bc-6a7486dbcee5","module_id":"365e5da2-5caa-4b8b-9ac8-91f1498aa6df","title":"Урок 3. Первая община и первые испытания (Деяния 3–5)","order_index":2,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"e143a8a0-8669-41ff-82b5-aef08db25aa4","module_id":"365e5da2-5caa-4b8b-9ac8-91f1498aa6df","title":"Мини-квиз: Модуль 1","order_index":3,"chapter_type":"quiz","requires_completion":false,"is_locked":false}]},{"id":"8d6c45e4-f046-4a68-a4e5-02d09c3ef785","course_id":"1f3c4803-d229-464b-ad8e-848a0355e71f","title":"Модуль 2. Расширение: от Иерусалима к народам (Деяния 6–12)","description":"Служение Стефана и его мученичество, Филипп в Самарии и с эфиопским евнухом, обращение Савла, поворотная глава о Корнилии и рождение многонациональной Антиохийской церкви.","order_index":1,"due_date":null,"chapters":[{"id":"96d7dd52-330e-4e20-850d-a34989e58fb2","module_id":"8d6c45e4-f046-4a68-a4e5-02d09c3ef785","title":"Урок 4. Стефан: первый мученик и его речь (Деяния 6–7)","order_index":0,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"7750dd4a-700d-4763-85b2-c2f411e1d582","module_id":"8d6c45e4-f046-4a68-a4e5-02d09c3ef785","title":"Урок 5. Филипп: Евангелие пересекает границы (Деяния 8)","order_index":1,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"6f53645b-5a49-485c-8736-eedf5a34d196","module_id":"8d6c45e4-f046-4a68-a4e5-02d09c3ef785","title":"Урок 6. Обращение Савла (Деяния 9)","order_index":2,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"6eed61a1-f5bc-4158-bb68-1e689bcf7a80","module_id":"8d6c45e4-f046-4a68-a4e5-02d09c3ef785","title":"Урок 7. Корнилий и Антиохия: открытая дверь народам (Деяния 10–12)","order_index":3,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"4644b9d0-3148-44ba-9a2b-a6095f0c6297","module_id":"8d6c45e4-f046-4a68-a4e5-02d09c3ef785","title":"Мини-квиз: Модуль 2","order_index":4,"chapter_type":"quiz","requires_completion":false,"is_locked":false}]},{"id":"5f3b8895-ad79-4ee7-9467-c080cd7d9902","course_id":"1f3c4803-d229-464b-ad8e-848a0355e71f","title":"Модуль 3. Миссия Павла: от Антиохии до суда (Деяния 13–26)","description":"Три миссионерских путешествия, Иерусалимский собор, Евангелие в Европе, трёхлетнее служение в Ефесе, арест в Иерусалиме и защитительные речи Павла перед правителями.","order_index":2,"due_date":null,"chapters":[{"id":"92f662e9-a03e-4931-a3ca-281f26419792","module_id":"5f3b8895-ad79-4ee7-9467-c080cd7d9902","title":"Урок 8. Первое путешествие и Иерусалимский собор (Деяния 13–15)","order_index":0,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"0f43db1a-baf5-437d-af27-79bbdacecafc","module_id":"5f3b8895-ad79-4ee7-9467-c080cd7d9902","title":"Урок 9. Евангелие в Европе: Филиппы, Афины, Коринф (Деяния 16–18)","order_index":1,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"0032d80d-c6f3-4926-b02a-c7c842765a6e","module_id":"5f3b8895-ad79-4ee7-9467-c080cd7d9902","title":"Урок 10. Ефес, прощание и арест Павла (Деяния 19–23)","order_index":2,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"dbfe611b-94bf-41ed-b093-482f6805f7ba","module_id":"5f3b8895-ad79-4ee7-9467-c080cd7d9902","title":"Урок 11. Суды Павла: апология перед миром (Деяния 24–26)","order_index":3,"chapter_type":"reading","requires_completion":false,"is_locked":false},{"id":"8b2e3d09-ab07-416a-88d9-cb4f9c0f3936","module_id":"5f3b8895-ad79-4ee7-9467-c080cd7d9902","title":"Мини-квиз: Модуль 3","order_index":4,"chapter_type":"quiz","requires_completion":false,"is_locked":false}]},{"id":"4e3ae45d-c80a-4ad6-877d-05efc8da2f45","course_id":"1f3c4803-d229-464b-ad8e-848a0355e71f","title":"Модуль 4. Путь в Рим, синтез и экзамен (Деяния 27–28)","description":"Кораблекрушение, прибытие в Рим, открытый финал книги Деяний, синтез богословских тем курса и итоговый экзамен с эссе.","order_index":3,"due_date":null,"chapters":[{